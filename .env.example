# Conductor ERP — environment template.
# Copy to `.env` and adjust for the local / customer environment.
# Customer-hosted, single-tenant: every value is owned by the customer.
#
# The defaults below are safe for LOCAL DEV. For a production install:
#   1. Set DJANGO_SETTINGS_MODULE=config.settings.prod
#   2. Generate a real DJANGO_SECRET_KEY (see note below) and set DJANGO_DEBUG=false
#   3. Set DJANGO_ALLOWED_HOSTS to your real host(s)
#   4. Review the SECURITY and EMAIL sections — the prod profile defaults to HTTPS/HSTS on.
# Every key here has a code default (config/settings/base.py, prod.py); anything left unset
# falls back to that default. Only override what your environment needs.

# ============================================================================
# Django core
# ============================================================================
# dev:  config.settings.dev    prod: config.settings.prod
DJANGO_SETTINGS_MODULE=config.settings.dev

# In prod this MUST be a long, random, unique value (no default — the app won't start without it).
# Generate one:  python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=dev-insecure-change-me

# false in prod. When false, DEBUG error pages are off and static is served via WhiteNoise.
DJANGO_DEBUG=true

# Comma-separated hostnames the app will answer to. Set to your real domain(s) in prod.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated CIDRs/IPs allowed to reach the API (IP whitelisting). Empty = allow all (dev only).
DJANGO_IP_WHITELIST=

# App version string surfaced in the UI / health checks.
APP_VERSION=0.0.0

# ============================================================================
# Database (PostgreSQL 16)
# ============================================================================
DATABASE_URL=postgresql://erp:erp@localhost:5432/erp
# The simulated external-ERP target used by the workflow SQL adapter lives in the
# same instance under schema "erp_external" (created by a migration) — no second server.

# ============================================================================
# Redis (Celery broker + result backend)
# ============================================================================
REDIS_URL=redis://localhost:6379/0

# Run Celery tasks inline in the calling process (no worker needed). Keep false in prod.
CELERY_TASK_ALWAYS_EAGER=false

# ============================================================================
# File / document storage
# ============================================================================
STORAGE_ROOT=./storage

# Where nightly backups land (see RUNBOOK §5). Optional — leave empty if you haven't set up the
# scheduled backup job yet; the system status panel then honestly shows "not configured" instead
# of guessing a path.
BACKUP_DIR=

# ============================================================================
# Ports (dev convenience)
# ============================================================================
API_PORT=8000
WEB_PORT=5173

# ============================================================================
# Security (config.settings.prod — HTTPS install)
# ----------------------------------------------------------------------------
# The prod profile defaults these to SECURE. Only relax them for a deliberately
# HTTP-only / internal install. Ignored under the dev profile.
# ============================================================================
# Secure flag on session/CSRF cookies (requires HTTPS). Default: true.
DJANGO_COOKIE_SECURE=true
# Redirect all HTTP to HTTPS. Default: true. Set false only behind a plain-HTTP internal network.
DJANGO_SSL_REDIRECT=true
# HSTS max-age in seconds. Default: 31536000 (1 year). Set 0 to disable HSTS.
DJANGO_HSTS_SECONDS=31536000
# Content-Security-Policy header. Default is a strict self-only policy (see prod.py). Empty disables.
DJANGO_CSP_POLICY=
# Origins trusted for unsafe (POST/PUT/…) requests, e.g. https://erp.customer.com. Comma-separated.
DJANGO_CSRF_TRUSTED_ORIGINS=
# Extra CORS origins — only if the SPA is hosted on a DIFFERENT origin than the API.
# Same-origin (SPA served behind Django) needs nothing here. Comma-separated.
DJANGO_CORS_ALLOWED_ORIGINS=

# ============================================================================
# Rate limiting (DRF throttles)
# ============================================================================
DRF_THROTTLE_ANON=60/min
DRF_THROTTLE_USER=1000/min
# Dedicated brute-force cap on the login endpoint (per IP; sits under the anon rate).
DRF_THROTTLE_LOGIN=5/min

# ============================================================================
# Workflow egress (SSRF guard)
# ----------------------------------------------------------------------------
# Outbound REST/webhook calls are default-deny to private/loopback/link-local IPs.
# Set an allowlist of host suffixes to permit specific external endpoints. Comma-separated.
# Empty = block only the private ranges (public hosts still allowed).
# ============================================================================
WORKFLOW_EGRESS_ALLOWLIST=

# ============================================================================
# Email (notifications channel)
# ----------------------------------------------------------------------------
# Default backend prints to the console and never touches the network (offline-safe).
# For real delivery, point EMAIL_BACKEND at SMTP and fill host/port/credentials.
# ============================================================================
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=conductor@example.com
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true

# ============================================================================
# AI assistant (OPTIONAL layer — off unless a key is present)
# ----------------------------------------------------------------------------
# A customer install with no key runs fully; the AI UI simply stays hidden.
# Any key set joins an automatic failover chain. Set ASSISTANT_PROVIDER to force one first.
# Providers: anthropic (Claude), gemini (Google), mistral, groq.
# ============================================================================
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
ASSISTANT_PROVIDER=

# ============================================================================
# E-invoicing — Egyptian Tax Authority (ETA)
# ----------------------------------------------------------------------------
# OPTIONAL layer. With these unset the ERP uses the SIMULATED adapter
# (erp/einvoice/services/eta_adapter.py) and never contacts ETA — an install with no tax
# integration runs completely normally.
#
# Environment URLs (verified 2026-07-20 against https://sdk.invoicing.eta.gov.eg/faq/ — re-check
# before go-live, ETA changes these):
#   Pre-production (test):  identity https://id.preprod.eta.gov.eg
#                           API      https://api.preprod.invoicing.eta.gov.eg
#                           portal   https://profile.preprod.eta.gov.eg  (register here to get creds)
#   Production:             identity https://id.eta.gov.eg
#                           API      https://api.invoicing.eta.gov.eg
#                           portal   https://profile.eta.gov.eg
#
# Auth is OAuth2 client_credentials with scope "InvoicingAPI"; tokens last ~1 hour.
# ALWAYS prove a flow against pre-production before pointing ETA_ENV at production.
# The client secret is a real credential: keep it out of git (.env is gitignored), out of logs,
# and out of the operator status panel (which reports variable NAMES only, never values).
#
# NOTE (2026-07-21): a System Admin can now enter all of the below in-app at
#   Settings → E-Invoicing (and click "Test connection" against pre-production).
# The in-app config takes precedence when enabled; these env vars remain a valid fallback for
# ops-seeded installs. The in-app client secret is stored ENCRYPTED with ETA_SECRET_KEY.
# ============================================================================
ETA_ENV=
ETA_IDENTITY_URL=
ETA_API_BASE_URL=
ETA_CLIENT_ID=
ETA_CLIENT_SECRET=
ETA_RIN=
# Fernet key encrypting the in-app ETA client secret. Empty = derived from DJANGO_SECRET_KEY (dev).
# In production set an explicit key so the stored secret survives a SECRET_KEY rotation. Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ETA_SECRET_KEY=
